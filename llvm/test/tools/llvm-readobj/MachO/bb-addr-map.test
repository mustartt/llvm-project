## Test that llvm-readobj can decode the MachO __LLVM,__llvm_bbaddrmap section,
## including PGO analysis data (function entry count, block frequencies and
## branch probabilities). The pointer-sized function address is resolved
## through the section's relocation to the function symbol.

# RUN: yaml2obj %s -o %t.o
# RUN: llvm-readobj %t.o --bb-addr-map --pretty-pgo-analysis-map | FileCheck %s

# CHECK:      BBAddrMap [
# CHECK-NEXT:   Function {
# CHECK-NEXT:     At: 0x0
# CHECK-NEXT:     Name: _foo
# CHECK-NEXT:     BB Ranges [
# CHECK-NEXT:       {
# CHECK-NEXT:         Base Address: 0x0
# CHECK-NEXT:         BB Entries [
# CHECK-NEXT:           {
# CHECK-NEXT:             ID: 0
# CHECK-NEXT:             Offset: 0x0
# CHECK-NEXT:             Size: 0x8
# CHECK:                  CanFallThrough: Yes
# CHECK:              ]
# CHECK:            }
# CHECK:          ]
# CHECK:          PGO analyses {
# CHECK-NEXT:       FuncEntryCount: 0
# CHECK-NEXT:       PGO BB entries [
# CHECK-NEXT:         {
# CHECK-NEXT:           Frequency: 1.0
# CHECK-NEXT:           Successors [
# CHECK-NEXT:             {
# CHECK-NEXT:               ID: 2
# CHECK-NEXT:               Probability: 0x50000000 / 0x80000000 = 62.50%
# CHECK-NEXT:             }
# CHECK-NEXT:             {
# CHECK-NEXT:               ID: 3
# CHECK-NEXT:               Probability: 0x30000000 / 0x80000000 = 37.50%
# CHECK-NEXT:             }
# CHECK-NEXT:           ]
# CHECK-NEXT:         }

--- !mach-o
FileHeader:
  magic:           0xFEEDFACF
  cputype:         0x100000C
  cpusubtype:      0x0
  filetype:        0x1
  ncmds:           3
  sizeofcmds:      496
  flags:           0x2000
  reserved:        0x0
LoadCommands:
  - cmd:             LC_SEGMENT_64
    cmdsize:         392
    segname:         ''
    vmaddr:          0
    vmsize:          192
    fileoff:         528
    filesize:        192
    maxprot:         7
    initprot:        7
    nsects:          4
    flags:           0
    Sections:
      - sectname:        __text
        segname:         __TEXT
        addr:            0x0
        size:            32
        offset:          0x210
        align:           2
        reloff:          0x2D0
        nreloc:          1
        flags:           0x80000400
        reserved1:       0x0
        reserved2:       0x0
        reserved3:       0x0
        content:         1F000071AD000054FD7BBFA900000094FD7BC1A8C0035FD640008052C0035FD6
        relocations:
          - address:         0xC
            symbolnum:       5
            pcrel:           true
            length:          2
            extern:          true
            type:            2
            scattered:       false
            value:           0
      - sectname:        __llvm_bbaddrmap
        segname:         __LLVM
        addr:            0x20
        size:            68
        offset:          0x230
        align:           0
        reloff:          0x2D8
        nreloc:          1
        flags:           0x0
        reserved1:       0x0
        reserved2:       0x0
        reserved3:       0x0
        content:         0527000000000000000000030000000808020001080801030000080100808080808080802002028080808005038080808003808080808080801400808080808080800C00
        relocations:
          - address:         0x3
            symbolnum:       4
            pcrel:           false
            length:          3
            extern:          true
            type:            0
            scattered:       false
            value:           0
      - sectname:        __compact_unwind
        segname:         __LD
        addr:            0x68
        size:            32
        offset:          0x278
        align:           3
        reloff:          0x2E0
        nreloc:          1
        flags:           0x2000000
        reserved1:       0x0
        reserved2:       0x0
        reserved3:       0x0
        content:         '0000000000000000200000000000000300000000000000000000000000000000'
        relocations:
          - address:         0x0
            symbolnum:       1
            pcrel:           false
            length:          3
            extern:          false
            type:            0
            scattered:       false
            value:           0
      - sectname:        __eh_frame
        segname:         __TEXT
        addr:            0x88
        size:            56
        offset:          0x298
        align:           3
        reloff:          0x2E8
        nreloc:          2
        flags:           0x6800000B
        reserved1:       0x0
        reserved2:       0x0
        reserved3:       0x0
        content:         1000000000000000017A520001781E01100C1F002000000018000000E4FFFFFFFFFFFFFF2000000000000000004C0E109E019D0200000000
        relocations:
          - address:         0x1C
            symbolnum:       3
            pcrel:           false
            length:          3
            extern:          true
            type:            1
            scattered:       false
            value:           0
          - address:         0x1C
            symbolnum:       4
            pcrel:           false
            length:          3
            extern:          true
            type:            0
            scattered:       false
            value:           0
  - cmd:             LC_SYMTAB
    cmdsize:         24
    symoff:          760
    nsyms:           6
    stroff:          856
    strsize:         40
  - cmd:             LC_DYSYMTAB
    cmdsize:         80
    ilocalsym:       0
    nlocalsym:       4
    iextdefsym:      4
    nextdefsym:      1
    iundefsym:       5
    nundefsym:       1
    tocoff:          0
    ntoc:            0
    modtaboff:       0
    nmodtab:         0
    extrefsymoff:    0
    nextrefsyms:     0
    indirectsymoff:  0
    nindirectsyms:   0
    extreloff:       0
    nextrel:         0
    locreloff:       0
    nlocrel:         0
LinkEditData:
  NameList:
    - n_strx:          29
      n_type:          0xE
      n_sect:          1
      n_desc:          0
      n_value:         0
    - n_strx:          23
      n_type:          0xE
      n_sect:          2
      n_desc:          0
      n_value:         32
    - n_strx:          17
      n_type:          0xE
      n_sect:          3
      n_desc:          0
      n_value:         104
    - n_strx:          11
      n_type:          0xE
      n_sect:          4
      n_desc:          0
      n_value:         136
    - n_strx:          6
      n_type:          0xF
      n_sect:          1
      n_desc:          0
      n_value:         0
    - n_strx:          1
      n_type:          0x1
      n_sect:          0
      n_desc:          0
      n_value:         0
  StringTable:
    - ''
    - _ext
    - _foo
    - ltmp3
    - ltmp2
    - ltmp1
    - ltmp0
    - ''
    - ''
    - ''
    - ''
    - ''
...
